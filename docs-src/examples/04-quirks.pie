.: Assign to anything
.: The left side of = can be any expression, not just a name.
print = __builtin_print;
infix + = (a, b) => __builtin_add(a, b);

2 + 2 = 5;
print(2 + 2);
print(1 + 3);

1 = 100;
print(1);

"Hello" = "Goodbye";
print("Hello");

.: It only lasts until the end of the block.
{
    true = false;
    print(true);
};
print(true);
